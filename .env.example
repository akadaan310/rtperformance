# ── Supabase (required) ───────────────────────────────────────────────────────
# Project URL and anon (publishable) key from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the deployed app (used for invitation links and auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role key: ONLY for operator scripts (scripts/provision-owner.mjs, scripts/seed-dev.mjs).
# The web app never reads it. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── The Tech Guy (optional — the rest of the app works without it) ───────────
ANTHROPIC_API_KEY=
# Model id, chosen per account. Recommended: a current low-cost Haiku model, e.g. claude-haiku-5-5
ANTHROPIC_MODEL=
# Per-user daily budgets and request timeout
AI_DAILY_REQUEST_LIMIT=150
AI_DAILY_TOKEN_LIMIT=400000
AI_TIMEOUT_MS=45000
# low | medium | high (default low)
AI_EFFORT=low

# ── Optional ──────────────────────────────────────────────────────────────────
# Business time zone for "today" (Tampa, FL)
NEXT_PUBLIC_APP_TIMEZONE=America/New_York
# Shows a "Meet Raymond" link on the landing page to /t/<slug>
NEXT_PUBLIC_PRIMARY_WORKSPACE_SLUG=rt-performance
# Test runs only: multiplies the sign-in/sign-up rate limits
# AUTH_RATE_LIMIT_FACTOR=1
